NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/fintech_smart_invoice
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CLIENT_URL=http://localhost:5173
# Optional outbound email (required for manual invoice email and reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FinFlow <no-reply@example.com>
REMINDER_CRON=0 9 * * *
REMINDER_TIMEZONE=Asia/Kolkata
